{
  "name": "local-laboratory",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "本机二维旋转装甲射击实验室",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/check-installed-lifecycle.mjs",
    "preview": "node --import tsx scripts/preview.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "pretest": "node scripts/build-runner.mjs",
    "benchmark:control": "node --import tsx scripts/control-benchmark.ts",
    "benchmark:vision": "node scripts/build-runner.mjs && node --import tsx scripts/vision-endurance.ts"
  },
  "devDependencies": {
    "@ffmpeg-installer/win32-x64": "4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "jpeg-js": "0.4.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
